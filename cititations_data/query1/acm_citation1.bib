@article{10.1145/3799251,
author = {Tisha, Zakia Tamanna and Guin, Ujjwal},
title = {Understanding the Security Landscape of Embedded Non-Volatile Memories: A Comprehensive Survey},
year = {2026},
issue_date = {April 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {22},
number = {2},
issn = {1550-4832},
url = {https://doi.org/10.1145/3799251},
doi = {10.1145/3799251},
abstract = {The modern semiconductor industry requires memory solutions that can keep pace with the high-speed demands of high-performance computing. Embedded non-volatile memories (eNVMs) address these requirements by offering faster access to stored data at an improved computational throughput and efficiency. Furthermore, these technologies offer numerous appealing features, including limited area-energy-runtime budget and data retention capabilities. Among these, the data retention feature of eNVMs has garnered particular interest within the semiconductor community. Although this property allows eNVMs to retain data even in the absence of a continuous power supply, it also introduces some vulnerabilities, prompting security concerns. These concerns have sparked increased interest in examining the broader security implications associated with eNVM technologies. This article examines the security aspects of eNVMs by discussing the reasons for vulnerabilities in specific memories from an architectural point of view. Additionally, this article extensively reviews eNVM-based security primitives, such as physically unclonable functions and true random number generators, as well as techniques like logic obfuscation. This article also explores a broad spectrum of security threats to eNVMs, including physical attacks such as side-channel attacks, fault injection, and probing, as well as logical threats like information leakage, denial-of-service, and thermal attacks. Finally, this article presents a study of publication trends in the eNVM domain since the early 2000s, reflecting the rising momentum and research activity in this field.},
journal = {J. Emerg. Technol. Comput. Syst.},
month = apr,
articleno = {14},
numpages = {26},
keywords = {Non-volatile memories, security primitives, PUFs, TRNGs, side-channel analysis, probing, fault injection}
}

@article{10.1145/3803849,
author = {Jang, Seokjun and Moon, Youngki and Won, Duyeon and Kim, Wonjun and Kang, Sungho},
title = {Evolution of Obfuscation-Based Scan Design Techniques},
year = {2026},
issue_date = {August 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {58},
number = {11},
issn = {0360-0300},
url = {https://doi.org/10.1145/3803849},
doi = {10.1145/3803849},
abstract = {Scan chains inserted into the circuit can be exploited as side channels for attackers. This has led to a growing need for secure scan design. The research in the secure scan design started from primitive techniques that involve adding specific gates in the circuit to hinder the interpretation of output data. Subsequently, various attack methods emerged, leading to the differentiation of secure scan design into various categories. In this survey article, the technical goal of each approach is introduced first. Subsequently, research evolution of secure scan designs is analyzed, aiming to present the directions for future studies.},
journal = {ACM Comput. Surv.},
month = apr,
articleno = {288},
numpages = {34},
keywords = {Secure scan design, scan obfuscation, post SAT countermeasure}
}

@article{10.1145/3809165,
author = {Bangamuarachchi, Wageesha and Dawson, Joshua and Wiese, Jason},
title = {Hospital Administrator Perspectives on Integrating Novel Interactive Technology in the Hospital},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3809165},
doi = {10.1145/3809165},
abstract = {Hospitals and other healthcare settings benefit from the development and deployment of innovative interactive technology to better serve the needs of patients and employees alike. However, there are likely incompatibilities between the typical processes surrounding technology innovation and the processes that are central to a hospital’s functioning to facilitate patient care and meet employee needs. In this paper, we examine hospital administrators’ perspectives on the deployment of novel interactive technology in a real-world hospital setting. We conducted 13 semi-structured interviews with non-patient-facing employees at a rehabilitation hospital that had recently deployed novel smart patient rooms across all 75 rooms. Our findings indicate that prototyping was crucial for informing deployment decisions; however, scaling introduced unforeseen challenges, including financial and staffing complexities and an incomplete understanding of costs versus benefits. While the technology increased patient independence and reduced staff workload, reliability issues and overreliance on technology sometimes disrupted workflows and rehabilitation. These findings contribute by providing insights into the complex organizational effort involved in large-scale technology deployment, as well as the decision-making process for designing, deploying, and evaluating it. Future HCI researchers should explore opportunities to make HCI methods for ideation, prototyping, and evaluation more accessible in this setting.},
note = {Just Accepted},
journal = {ACM Trans. Comput. Healthcare},
month = apr,
keywords = {smart hospital technology, smart home technology, accessibility, design}
}

@article{10.1145/3799976,
author = {Ingold, Amy and Lee, Loong Yi and Diteesawat, Richard Suphapol and Roshan, Ajmal and Zekaria, Yael and Hall, Edith-Clare and Werner, Enrico and Rahman, Nahian and Czech, Elaine and Rossiter, Jonathan M.},
title = {Soft Robotic Technological Probe for Speculative Fashion Futures},
year = {2026},
issue_date = {May 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {15},
number = {3},
url = {https://doi.org/10.1145/3799976},
doi = {10.1145/3799976},
abstract = {Emerging wearable robotics demand design approaches that address not only function but also social meaning. In response, we present Sumbrella, a soft robotic garment developed as a speculative fashion probe. We first detail the design and fabrication of the Sumbrella, including sequenced origami-inspired bistable units, fabric pneumatic actuation chambers, cable-driven shape morphing mechanisms, computer vision components and an integrated wearable system comprising a hat and bolero jacket housing power and control electronics. Through a focus group with 12 creative technologists, we then used Sumbrella as a technological probe to explore how people interpreted, interacted and imagined future relationships with soft robotic wearables. While Sumbrella allowed our participants to engage in rich discussion around speculative futures and expressive potential, it also surfaced concerns about exploitation, surveillance and the personal risks and societal ethics of embedding biosensing technologies in public life. We contribute to the Human–Robot Interaction (HRI) field key considerations and recommendations for designing soft robotic garments, including the potential for kinesic communication, the impact of such technologies on social dynamics and the importance of ethical guidelines. Finally, we provide a reflection on our application of speculative design, proposing that it allows HRI researchers to not only consider functionality but also how wearable robots influence definitions of what is considered acceptable or desirable in public settings.},
journal = {J. Hum.-Robot Interact.},
month = apr,
articleno = {62},
numpages = {28},
keywords = {Soft robotics, fashion, speculative futures, wearable technology, social interaction}
}

@inproceedings{10.1145/3789456.3796191,
author = {Yang, Qiong and Ma, Li and Tu, Shanshan and Ai, Xin and Li, Kun},
title = {A Hybrid Chebyshev Chaotic Map-based Authentication Protocol for Industrial Internet of Things},
year = {2026},
isbn = {9798400722738},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789456.3796191},
doi = {10.1145/3789456.3796191},
abstract = {The continuous advancement of Internet of Things (IoT) technologies has given rise to the concept of the Industrial Internet of Things (IIoT), marking a new era of intelligent manufacturing. However, the diverse IoT devices deployed within IIoT infrastructures are required to exchange data over open public channels, which exposes them to serious security and privacy threats. Existing authentication protocols often struggle to strike an effective balance between system overhead and security functionality, rendering them unsuitable for resource-constrained IIoT environments. To address these challenges, this paper proposes a hybrid authentication protocol specifically tailored for IIoT scenarios and built upon Chebyshev chaotic maps. By jointly integrating Chebyshev chaotic mapping, physical unclonable functions (PUFs), and various cryptographic techniques, the proposed protocol provides robust security guarantees while minimizing system overhead. Consequently, it offers an effective and practical solution for secure data transmission in IIoT environments.},
booktitle = {Proceedings of the 2025 15th International Conference on Communication and Network Security},
pages = {30–35},
numpages = {6},
keywords = {Chebyshev chaotic maps, physical unclonable functions, authentication},
location = {
},
series = {ICCNS '25}
}

@inproceedings{10.1145/3789456.3796192,
author = {Ai, Xin and Li, Kun and Tu, Shanshan},
title = {A Quantum-Secure Authentication Protocol For UAV-GS Communications},
year = {2026},
isbn = {9798400722738},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789456.3796192},
doi = {10.1145/3789456.3796192},
abstract = {With the widespread deployment of unmanned aerial vehicles (UAVs) in both military and civilian domains, the demand for secure and encrypted communications in UAV networks integrated with ground stations has become increasingly prominent. Authentication and key agreement protocols are widely regarded as essential technical mechanisms for ensuring the security of data transmission in wireless communication environments. However, the rapid advancement of quantum computing technologies poses potential security threats to conventional protocols based on elliptic curve cryptography. To address these challenges, this paper proposes a quantum-secure authentication and key agreement protocol tailored for UAV–ground station communication scenarios. By incorporating Crystal-Kyber, the proposed protocol ensures quantum resistance while striving to minimize system computational overhead. The results of the informal security analysis indicate that the proposed protocol can effectively withstand a variety of known attacks. In addition, comprehensive comparative evaluations with existing related protocols demonstrate that, while maintaining low computational overhead, the proposed scheme exhibits stronger robustness in terms of security and functional properties.},
booktitle = {Proceedings of the 2025 15th International Conference on Communication and Network Security},
pages = {100–104},
numpages = {5},
keywords = {unmanned aerial vehicles, Authentication, Crystal-Kyber},
location = {
},
series = {ICCNS '25}
}

