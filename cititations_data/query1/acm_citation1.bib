author = {Sun, Minqing and Ding, Lanqi and Zhu, Huifeng and Jin, Yier and Zou, An},
title = {From ICs to Device: A Survey on Hardware Tampering Detection via Power Delivery Network and Signal Trace},
year = {2026},
