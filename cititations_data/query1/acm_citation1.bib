author = {Kaczmarczyk, Lisa},
title = {We can do interdisciplinarity},
year = {2007},
issue_date = {June 2007},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {39},
number = {2},
issn = {0097-8418},
url = {https://doi.org/10.1145/1272848.1272868},
doi = {10.1145/1272848.1272868},
abstract = {The year 2006 witnessed an unexpected milestone in my life: my first encounter with Poison Ivy. Not that I had never seen nor touched the infamous Rhus radicans before. Quite the contrary. A committed nature lover since birth, I have spent around four decades gloriously bushwhacking, tree hugging, dirt digging, bug chasing, rock clambering, and animal tracking. My body has suffered many indignities with aplomb. In each of these situations, I have watched with rapt attention the scientific processes at work: the sucking sounds as tweezers pull each cactus spine from my leg; the predictable trajectory of chigger blisters aiming towards their rendezvous on my toe with a fire-ant bite.},
journal = {SIGCSE Bull.},
month = jun,
pages = {20–21},
numpages = {2}
}

@inproceedings{1266366.1266508,
author = {Verbauwhede, Ingrid and Schaumont, Patrick},
title = {Design methods for security and trust},
year = {2007},
isbn = {9783981080124},
publisher = {EDA Consortium},
address = {San Jose, CA, USA},
abstract = {The design of ubiquitous and embedded computers focuses on cost factors such as area, power-consumption, and performance. Security and trust properties, on the other hand, are often an afterthought. Yet the purpose of ubiquitous electronics is to act and negotiate on their owner's behalf, and this makes trust a first-order concern. We outline a methodology for the design of secure and trusted electronic embedded systems, which builds on identifying the secure-sensitive part of a system (the root-of-trust) and iteratively partitioning and protecting that root-of-trust over all levels of design abstraction. This includes protocols, software, hardware, and circuits. We review active research in the area of secure design methodologies.},
booktitle = {Proceedings of the Conference on Design, Automation and Test in Europe},
pages = {672–677},
numpages = {6},
location = {Nice, France},
series = {DATE '07}
}

@article{10.1145/1229899.1229919,
author = {Kelly-Bootle, Stan},
title = {As Big as a Barn? Taking measure of measurement},
year = {2007},
issue_date = {March 2007},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
