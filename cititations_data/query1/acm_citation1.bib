publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803784.3809288},
doi = {10.1145/3803784.3809288},
abstract = {How can storytelling and tangible making support children's creative expression while also acting as a pedagogical tool for planetary care? We present BioFabulations, a methodological assemblage comprising a toolkit-in-the-making and a framework, illustrated through a situated case study. The work unfolds in three stages: (1) Observe, (2) Create and Fabulate, (3) Animate and Tell. Through a series of activities, children are invited to notice and document coastal life and human presence, to sketch and model magical creatures and bring their stories to life through digital stop-motion animation. Shifting from abstract knowledge to embodied, relational engagement, this work illustrates how direct encounters with local ecologies cultivate awareness, curiosity, and care; and how intersecting HCI, materials-making, and storytelling support children in internalising ecological concepts through creative learning.},
booktitle = {Proceedings of the 2026 Conference on Creativity and Cognition},
pages = {881–895},
numpages = {15},
keywords = {Biomaterials, Design tools, Digital storytelling},
location = {
},
series = {C&amp;C '26}
