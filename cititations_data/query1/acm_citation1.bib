@inproceedings{10.1145/3582437.3582445,
author = {Maram, Sai Siddartha and Pfau, Johannes and Dodechani, Jai Bhagu and Seif El-Nasr, Magy},
title = {A Visual Ethnographic Study at Cultural Spaces to Identify Character Creation Opportunities},
year = {2023},
isbn = {9781450398558},
publisher = {Association for Computing Machinery},
