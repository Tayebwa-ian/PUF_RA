@inproceedings{10.1109/DAC63849.2025.11133290,
author = {Lin, Ning and Li, Yi and He, Yangu and Wang, Songqi and Chen, Hegan and Wong, Kwunhang and Li, Chuxin and Yang, Jichang and Yu, Yifei and Xu, Meng and Han, Yongkang and Chen, Rui and Chen, Xiaoming and Xu, Xiaoxin and Yang, Jianguo and Shang, Dashan and Wang, Zhongrui},
title = {Re4PUF: A Reliable, Reconfigurable ReRAM-based PUF Resilient to DNN and Side Channel Attacks},
year = {2025},
isbn = {9798331503048},
publisher = {IEEE Press},
url = {https://doi.org/10.1109/DAC63849.2025.11133290},
doi = {10.1109/DAC63849.2025.11133290},
abstract = {Resistive random-access memory (ReRAM) based Physical Unclonable Functions (PUFs) have emerged as an attractive hardware security primitive due to their low energy consumption and compact footprint. However, the reliability of existing ReRAM-based PUFs is challenged by read noise and temperature variations, as well as their resistance to Deep Neural Network (DNN) modeling attacks and Side Channel Attacks (SCAs). In this paper, we propose a novel 3T2R ReRAM-based reconfigurable PUF to address these challenges. By adopting the digital 3T2R voltage division cell design, we improve its reliability against ReRAM read noise and temperature variations, while the adjustable analog supply voltage of inverters enables quick, low-cost reconfigurability without reprogramming ReRAMs, effectively mitigating DNN modeling and SCA vulnerabilities. Our Re4PUF chip has been experimentally validated, achieving a low Bit Error Rate (BER) of 1% at 85°C, a 7.59-fold reduction compared to existing ReRAM-based PUFs. It also demonstrates robust resistance to both DNN modeling attacks (MLP and Transformer) and SCAs, with success rates of approximately 50% and less than 70%, respectively.},
booktitle = {Proceedings of the 62nd Annual ACM/IEEE Design Automation Conference},
articleno = {399},
numpages = {7},
keywords = {ReRAM, PUF, SCA, DNN modeling attack, reconfigurable},
location = {San Francisco, California, United States},
series = {DAC '25}
}

@inproceedings{10.1109/DAC63849.2025.11132847,
author = {Alsharkawy, Mohamed and Zwerschke, Jan and Nassar, Hassan and Gonz\'{a}lez-G\'{o}mez, Jeferson and Henkel, J\"{o}rg},
title = {Late Breaking Results: The Hidden Risks of Activation Duration in PLPUFs},
year = {2025},
isbn = {9798331503048},
publisher = {IEEE Press},
url = {https://doi.org/10.1109/DAC63849.2025.11132847},
doi = {10.1109/DAC63849.2025.11132847},
abstract = {The security of Internet of Things (IoT) devices is crucial to protect the vast amounts of data exposed due to their widespread adoption. Authentication is one of the key aspects of IoT security, but it becomes increasingly challenging, especially for resource-constrained devices that require lightweight and efficient solutions. Physical Unclonable Functions (PUFs) have emerged as a promising lightweight solution by using the unique physical properties of Integrated Circuits (ICs). Pseudo Liner Feedback Shift Register PUF (PLPUF) is one of the state-of-the-art implementations known for its flexibility in altering the challenge-response space by changing the activation duration. In this work, we demonstrate that selecting an appropriate activation duration for PLPUF is critical, as improper choices can compromise security. By analyzing the linear dependency between the responses of different PLPUF pairs, our results reveal that predictability can reach up to 96% when an unsuitable activation duration is chosen.},
booktitle = {Proceedings of the 62nd Annual ACM/IEEE Design Automation Conference},
articleno = {193},
numpages = {2},
keywords = {PUF, authentication, predictability},
location = {San Francisco, California, United States},
series = {DAC '25}
}

