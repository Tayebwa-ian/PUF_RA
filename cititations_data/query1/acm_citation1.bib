@inproceedings{10.1145/3803784.3807564,
author = {Li, Yixun and Ford, Andrea and Nissen, Bettina},
title = {Weaving as Material Narrative: Understanding and Designing for Menstrual Temporality, Lived Experience, and Invisible Pain},
year = {2026},
isbn = {9798400725838},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803784.3807564},
doi = {10.1145/3803784.3807564},
abstract = {Menstruation is a highly subjective and situated embodied experience, yet these aspects are frequently overlooked in current menstrual tracking technologies and healthcare settings. This research proposes weaving as a feminist approach to material narrative that can illuminate subjectivity and situated embodiment. Through three woven pieces exhibited in the UK, the study explores how weaving can express menstrual experiences in tangible and sensory ways, specifically focusing on: (1) cyclical bodily perceptions of time within cycles; (2) trivialised endometriosis pain in medical contexts; and (3) daily lived experiences beyond datafication. By describing and reflecting on the making process, we found that the tactile, slow, and reflective qualities of weaving facilitate deeper and more introspective bodily awareness. It also allows menstrual experiences to be expressed in more fluid and flexible ways, supporting individuals in validating and appreciating their bodies. Those insights encourage designers to focus on materially oriented, sensory, and felt approaches, thereby expanding the design possibilities within menstrual technologies and healthcare.},
booktitle = {Proceedings of the 2026 Conference on Creativity and Cognition},
pages = {999–1014},
numpages = {16},
keywords = {Embodied Interaction, Craft, Health and Wellbeing, Interaction Design, Menstruation, Research through Design, Feminist HCI, Materiality},
location = {
},
series = {C&amp;C '26}
}

