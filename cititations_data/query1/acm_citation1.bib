@article{10.1145/3793236.3793243,
author = {Ghoshal, Moinak and Khan, Imran and Kong, Z. Jonny and Basit, Omar and Wang, Sizhe and Feng, Yufei and Dinh, Phuc and Meng, Jiayi and Charlie Hu, Y. and Koutsonikolas, Dimitrios},
title = {Roads, Radios, and Reality: What 5G Looks Like From the Driver's Seat},
year = {2026},
