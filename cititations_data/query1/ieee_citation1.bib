	keywords = {Business, Counterfeiting, Cryptographic protocols, Cryptography, Frequency, Hardware, Microcontrollers, Radiofrequency identification, Security, Voltage},
	pages = {233--240},
}

@inproceedings{seyyedi_securing_2011,
