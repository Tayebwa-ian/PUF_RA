@inproceedings{parvin_special_2026,
	title = {Special {Session}: {Hardware} {Security} at the {Circuit} and {Layout} {Levels}},
	issn = {1558-1780},
	shorttitle = {Special {Session}},
	url = {https://ieeexplore.ieee.org/document/11591799/},
	doi = {10.1109/ETS69887.2026.11591799},
	abstract = {As Integrated Circuits (ICs) become ubiquitous in everyday applications, ensuring the security and reliability of the sensitive information they process has become a central challenge in hardware design. This paper brings together three complementary perspectives on security-aware integrated circuit design, spanning attack mitigation, robustness modeling, and emerging device technologies. First, we examine the growing threat of laserbased Side-Channel Analysis (SCA) attacks, particularly Optical Probing (OP), which exploits the transparency of silicon to NearInfraRed (NIR) light to recover internal chip information from the backside. In contrast to costly process-level solutions, we first highlight circuit- and layout-level countermeasures that are compatible with standard fabrication flows and enable designers to evaluate security, area, power, and performance trade-offs early in the design process. Second, we address the impact of process, voltage, temperature, aging, and package-induced mechanical stress in Physical Unclonable Functions (PUFs) design. By combining stress characterization, Verilog-A device modeling, and package-level measurements, we demonstrate how environmental and lifetime effects can be incorporated into the design flow to improve the stability and reliability of analog PUF-based security circuits. Third, we explore how emerging memristor technologies reshape hardware security for future chips. Although memristors exhibit substantial non-idealities, including variability, stochastic switching, and resistance drift, these properties can be exploited to realize compact, energyefficient PUFs and novel cryptographic building blocks. Overall, this paper emphasizes the need for cross-layer co-design across devices, circuits, and layouts to build secure, reliable, and futureready hardware systems.},
	urldate = {2026-07-27},
	booktitle = {2026 {IEEE} {European} {Test} {Symposium} ({ETS})},
	author = {Parvin, Sajjad and Riehm, Carl and Du, Nan and Brederlow, Ralf and Torres, Frank Sill and Drechsler, Rolf},
	month = may,
	year = {2026},
	note = {ISSN: 1558-1780},
	keywords = {Aging, Arrays, Circuits, component, Design methodology, formatting, insert, Logic, Modeling, Physical unclonable function, Printing, Security, Stress, style, styling},
	pages = {1--8},
}

@article{dong_non-invasive_2024,
	title = {Non-{Invasive} {Reverse} {Engineering} of {One}-{Hot} {Finite} {State} {Machines} {Using} {Scan} {Dump} {Data}},
	volume = {12},
	issn = {2168-6750},
	url = {https://ieeexplore.ieee.org/document/10280712/},
	doi = {10.1109/TETC.2023.3322299},
	abstract = {Finite-state machine (FSM) always works as a core control unit of a chip or a system. As a high level design, FSM has also been exploited to build multiple secure designs as it is deemed hard to discern FSM structure from the netlist or physical design. However, these secure designs can never sustain once the FSM structure is reversed. Reverse engineering FSM not only indicates the access of the control scheme of a design, but also poses a severe threat to those FSM-based secure designs. As the one-hot encoding FSM is widely adopted in various circuit designs, this paper proposes a non-invasive method to reverse engineer the one-hot encoding FSM. The data dumped from the scan chain during chip operation is first collected. The scan data is then used to identify all the candidate sets of state registers which satisfy two necessary conditions for one-hot state registers. Association relationship between the candidate registers and data registers are further evaluated to identify the unique target set of state registers. The transitions among FSM states are finally retrieved based on the scan dump data from those identified state registers. The experimental results on the benchmark circuits of different size show that this proposed method can identify all one-hot state registers exactly and the transitions can be retrieved at a high accuracy while the existing methods cannot achieve a satisfactory correct detection rate for one-hot encoding FSM.},
	number = {3},
	urldate = {2026-07-27},
	journal = {IEEE Transactions on Emerging Topics in Computing},
	author = {Dong, Zhaoxuan and Cui, Aijiao and Lu, Hao},
	month = jul,
	year = {2024},
	keywords = {Association rules mining, Data mining, Encoding, Finite-state machine (FSM) state registers, Integrated circuit modeling, one-hot coding, Physical design, Registers, Reverse engineering, scan data, Watermarking},
	pages = {795--809},
}

