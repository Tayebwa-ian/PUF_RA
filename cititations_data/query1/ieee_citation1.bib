	keywords = {Authentication, Cloning, Dynamic RAM (DRAM), Hardware, ID extraction, Integrated circuits, physically unclonable function (PUF), Random access memory, randomness, reliability, Reliability, system-level security, uniqueness},
	pages = {1085--1097},
}

