	month = oct,
	year = {2023},
	keywords = {Chiplet, Forward Trust, Heterogeneous Integration, Integrated circuits, Interposer, Measurement, Moore's Law, Obfuscation, Protocols, Reverse engineering, Semiconductor device modeling, System-in-package},
	pages = {1--7},
}

