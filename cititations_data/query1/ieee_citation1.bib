	keywords = {CMOS integrated circuits, Digital forensics, Emerging technologies, hardware security, memristors, Memristors, Nanoelectronics, Nanoscale devices, Network security, PCMs, Phase change materials, physical unclonable functions, Random access memory, Resistance},
	pages = {829--849},
