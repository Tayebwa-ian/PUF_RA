@inproceedings{kareem_physical_2021,
	title = {Physical {Unclonable} {Functions} based {Hardware} {Obfuscation} {Techniques}: {A} {State} of the {Art}},
	issn = {2166-0727},
	shorttitle = {Physical {Unclonable} {Functions} based {Hardware} {Obfuscation} {Techniques}},
