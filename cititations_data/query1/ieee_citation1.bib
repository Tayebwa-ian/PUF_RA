	keywords = {Authentication, Distributed Authentication, Fingerprint recognition, Hardware, IoT, Key Agreement, Physical unclonable function, Physically Unclonable Function, Protocols, Reverse engineering, Simulation},
	pages = {152--158},
}

@inproceedings{pappala_fpga_2012,
