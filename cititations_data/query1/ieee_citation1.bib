	keywords = {Circuits, delay side-channel, Delays, detection rate, golden free, Hardware, Hardware Trojan, Logic gates, Market research, Noise, Physical unclonable function, process variations, Security, Sensitivity, Trojan horses, virtual chip},
	pages = {4153--4166},
}

@inproceedings{perumalla_fast_2023,
