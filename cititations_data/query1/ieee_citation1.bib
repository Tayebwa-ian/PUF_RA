	keywords = {Delay, Hardware Security, Integrated circuit reliability, PUF, Resistance, RFID, Ring oscillators, Serial-In Serial-Out (SISO), Temperature Coefficient of Resistance, Temperature sensors, Zero temperature Coefficient Voltage},
	pages = {165--170},
}

@article{wang_modeling_2021,
