	keywords = {Adaptation models, cipher, Ciphers, CMOS integrated circuits, differential power analysis, encryption, Integrated circuit modeling, logic gate, Logic gates, Memristor, Memristors, Power demand, security primitive, SIMON},
	pages = {1--4},
}

@inproceedings{li_hardware_2015,
