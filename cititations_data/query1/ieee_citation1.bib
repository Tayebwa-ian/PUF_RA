@inproceedings{aarella_ipuf_2025,
	title = {{iPUF}: {A} {Novel} {Security}-by-{Design} {Paradigm} to {Mitigate} {Data} {Manipulation} and {External} {Attacks} in {Cyber}-{Physical} {Systems}},
