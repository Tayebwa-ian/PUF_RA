@inproceedings{aryati_dewi_how_2025,
	title = {How {Social} {Media} {Commerce} and {eWOM} {Shape} {User} {Technology} {Acceptance} and {Information} {Adoption} for {MSMEs} in {Denpasar}, {Bali}},
	url = {https://ieeexplore.ieee.org/document/11498927/},
	doi = {10.1109/DASA68193.2025.11498927},
	abstract = {This research investigates how social media marketing (SMM) and electronic word-of-mouth (eWOM) shape consumers’ purchase intentions in Bali’s fashion micro, small, and medium enterprises (MSMEs). The study also examines the mediating effects of perceived ease of use (PEU), perceived usefulness (PUF), and information adoption (IAD) within this context. A quantitative descriptive approach was adopted, collecting data from 209 respondents aged 18–35 who actively use Instagram and have previously purchased fashion products from MSMEs via social media. The collected data were analyzed using Partial Least Squares–Structural Equation Modeling (PLS-SEM) to evaluate the hypothesized relationships. Results indicate that SMM and eWOM significantly enhance both PEU and PUF, which, in turn, foster information adoption. This adoption then strongly influences consumers’ purchase intentions. The findings underscore the importance of interactive and user-oriented digital engagement in shaping consumer perceptions and decision-making in online fashion markets. By highlighting the central role of information adoption as a mediating mechanism, this study advances understanding of digital consumer behavior. Practically, the insights offer MSME practitioners guidance for optimizing social media strategies, emphasizing trust-building, interactivity, and user-friendly experiences to strengthen consumers’ readiness to purchase.},
	urldate = {2026-07-27},
	booktitle = {2025 {International} {Conference} on {Decision} {Aid} {Sciences} and {Applications} ({DASA})},
	author = {Aryati Dewi, Putu Jessita and Kencana Dewi, Ni Kadek Intan Pramesti and {Yuniarty} and Ikhsan, Ridho Bramulya and Aprilia Benhardy, Kartika},
	month = dec,
	year = {2025},
	keywords = {Circuits, Communication systems, Computer networks, Feedback, HTTP, information adoption, Integrated circuits, Internet, MSME, Protocols, social media, TAM, user behavior, Video equipment, Videos},
	pages = {2474--2479},
}

@article{mathew_circuits_2025,
	title = {Circuits for {Secure} {Root}-of-{Trust}: {TRNG}, {PUF}, {Attack}-{Resistant} {Cryptographic} {Accelerators} [{Feature}]},
	volume = {25},
	issn = {1558-0830},
	shorttitle = {Circuits for {Secure} {Root}-of-{Trust}},
	url = {https://ieeexplore.ieee.org/document/11317892/},
	doi = {10.1109/MCAS.2025.3595508},
	abstract = {Silicon-embedded root-of-trust circuits such as True Random Number Generators (TRNG) and Physically Unclonable Functions (PUF) are foundational primitives that generate dynamic and static entropy essential for data security and privacy applications. At the same time, secure platforms are vulnerable to physical side-channel and fault-injection attacks that attempt to steal embedded secret keys/IDs. This article describes all-digital area-efficient implementations of TRNGs and PUFs that generate cryptographic quality random bitstreams with tolerance to process/voltage/temperature variations. These include: (a) Ring-oscillator-based TRNG implementations that employ multiple injected-edges and beat frequency detectors to harvest and convert thermal noise-induced jitter into random bitstreams with throughput and energy-efficiency of 23Mbps and 15Mbps/mW respectively; (b) SRAM PUF with data-remanence bit-masking technique to identify 100\% stable bitcells; (c) Unified PUF-TRNG with a common-entropy source and self-calibrating Von Neumann extractor circuits generating PUF/TRNG random bit throughput of 0.56/1.48Gbps with 0.9996/0.99997 static/dynamic entropy respectively. A reconfigurable AES accelerator with minimum-traces-to-disclosure (MTD) {\textgreater}1{\textbackslash}textB traces in on-demand SCA-resistant mode, while also providing a 2.2{\textbackslash}times boost in encryption performance during a dual-core mode of operation is also described. Finally, a self-checking AES engine that uses arithmetic and parity checkers for real-time detection of laser and voltage-based attacks with up to 99.99\% fault coverage is described.},
	number = {4},
	urldate = {2026-07-27},
	journal = {IEEE Circuits and Systems Magazine},
	author = {Mathew, Sanu K. and Kumar, Raghavan and De, Vivek},
	year = {2025},
	keywords = {entropy source, fault-injection attack resistance, PUF, self-checking AES, side-channel-attack resistant AES, TRNG},
	pages = {55--63},
}
