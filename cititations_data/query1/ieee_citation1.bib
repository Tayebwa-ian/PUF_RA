	keywords = {Arbiter physical unclonable function (PUF), Computer architecture, Delays, Hardware, hardware security primitive, machine learning (ML), Microprocessors, Physical unclonable function, Security, spin-transfer torque magnetoresistive random access memory (STT-MRAM), Transistors},
