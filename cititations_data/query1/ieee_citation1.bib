	keywords = {Computer architecture, Discrete Fourier transforms, dynamic key generation, Generators, Hardware security, Manufacturing, memory attack, physical unclonable function (PUF), Random access memory, scan design, secure scan architecture, Security, side-channel attack, Testing},
	pages = {373--385},
}

