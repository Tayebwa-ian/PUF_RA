	keywords = {Accuracy, Binarized Neural Networks, Encryption, Energy efficiency, Memristors, Neural networks, Physical unclonable function, Physical Unclonable Function, Protection, PUF-Key Recovery Attacks, Reproducibility of results, Scalability, Security},
