	keywords = {Energy efficiency, FeFETs, Hardware security, HW security, logic locking, Multiplexing, Nonvolatile memory, Physical unclonable function, Protocols, PUFs, Semiconductor device modeling, Switches, Technological innovation},
	pages = {457--460},
}

@inproceedings{sivaraman_characteristic_2024,
	title = {Characteristic {Exploitation} of {Programmable} {Delay} {Line} {Influenced} {Oscillator} {Circuit} as {Hardware} {Security} {Primitive}},
	issn = {2380-6923},
	url = {https://ieeexplore.ieee.org/document/10483341/},
	doi = {10.1109/VLSID60093.2024.00086},
	abstract = {True Random Number Generators (TRNGs) are crucial components in hardware-entangled cryptography. These modules are effectively used for key generation, initialization vector generation, random simulations etc. The importance of hardware security urges us to develop a compact and scalable hardware security primitive such as TRNG, which can be an integrated module in Integrated Circuits (ICs). This work aims to design and prototype a non-identical Ring Oscillator (RO) based TRNG whose structure is modified using Programmable Delay Line (PDL) inverters. A 3-bit PDL inverter structure has been employed in this work. Hence, these inverters have three different delay control options through which the propagation delay of the inverters is controlled in eight possible ways. Jitters from the RO are disturbed using these delay controls, which increase the standard deviation of the jitters. This phenomenon produces high-quality true random bits. The design was developed using VHDL and implemented on Cyclone IV E Field Programmable Gate Array (FPGA). The true randomness was confirmed through restart experiments and autocorrelation. The average entropy of the true random bits is calculated as 0.999999, which is close to ideality. Further, random characteristics of RO TRNG have been verified through NIST SP 800 – 22 batteries of tests. This TRNG design occupies only {\textless}1\% of the total hardware elements of the target FPGA and dissipates 147.97 mW of power to generate 2 million bits at 24Mbps throughput.},
	urldate = {2026-07-26},
	booktitle = {2024 37th {International} {Conference} on {VLSI} {Design} and 2024 23rd {International} {Conference} on {Embedded} {Systems} ({VLSID})},
	author = {Sivaraman, R and Muralidaran, D and Muthaiah, R and Sriram, V S Shankar},
	month = jan,
