@inproceedings{srichanda_implementation_2025,
	title = {Implementation of {RO}- {PUF} {Based} {Authentication} for {Secure} {Electric} {Vehicle} {Charging}},
	url = {https://ieeexplore.ieee.org/document/11439433/},
	doi = {10.1109/ITEC-India67626.2025.11439433},
	abstract = {The timely integration of Electric Vehicles (EVs) and their alignment with smart grid architectures calls for the creation of sturdy and capable authentication frameworks to defend against cyber-physical vulnerabilities, privacy infringements, and unapproved entries. Authentication practices such as RFID smart cards, certificate-reliant protocols, and Plug-and-Charge systems demonstrate marked shortcomings in scalability, physical security, and their resilience to spoofing or changes. To counter the drawbacks, this document analyzes the application of Ring Oscillator-based Physically Unclonable Functions (RO-PUFs) as a minimalistic, hardware-integrated strategy for EV authentication at charging stations. This research details the design and implementation of an RO-PUF architecture on a Xilinx Artix-7 FPGA, which includes frequency measurement, challenge-response logic, and secure integration with the Vehicle Communication Controller and Onboard Charger of the EV. Experimental outcomes affirm the individuality and consistency of PUF signals across multiple FPGA variations, pointing out the system's toughness and resistance to replication. This architectural proposal boosts security at the electric vehicle and charging station tiers by allowing for mutual authentication and stopping unauthorized access. This study showcases the feasibility of deploying ROPUFs as a scalable, tamper-resistant authentication framework and lays the foundation for future advancements in secure EV infrastructure.},
	urldate = {2026-07-26},
