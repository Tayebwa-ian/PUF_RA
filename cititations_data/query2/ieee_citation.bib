	keywords = {Cloning, Hardware, Integrated circuit modeling, Invasive attack, Magnetic tunneling, Measurement, physically unclonable function (PUF), Security, Semiconductor device modeling, spin-transfer torque-magnetic random-access memory (STT-MRAM), tamper detection},
