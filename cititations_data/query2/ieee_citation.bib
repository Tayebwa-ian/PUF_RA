}

@article{ngo_lightweight_2026,
	title = {A {Lightweight} {PUF}-{Based} {Authentication} and {Key}-{Establishment} {Protocol} {With} {SoC} {Implementation} for {Industrial} {IoT}},
	issn = {1941-0050},
	url = {https://ieeexplore.ieee.org/document/11533467/},
	doi = {10.1109/TII.2026.3691373},
	abstract = {This article presents a novel lightweight authentication and secure communication protocol and its energy-efficient system-on-chip (SoC) implementation for resource-constrained industrial Internet of Things devices operating in unattended and physically exposed environments. The proposed protocol supports device-to-server verification, device-to-device mutual authentication, and session key establishment without storing long-term shared secret keys in nonvolatile memory (NVM), thereby mitigating physical key-extraction and cloning attacks common in exposed industrial deployments. Device-specific keying material is regenerated on demand from an on-chip challenge-response pairs (CRPs)-based physical unclonable function (PUF). Formal security analysis using Mao–Boyd logic and Scyther-based verification demonstrates resistance to replay, man in the middle, impersonation, side-channel, and physical cloning attacks, while protocol-level evaluation confirms low computational cost achieved through exclusive use of symmetric cryptography and a single PUF evaluation per session. Building on the proposed protocol, an energy-efficient SoC architecture is implemented and evaluated. The fabricated design in a 28-nm CMOS process occupies 191 kGE and operates at 25 MHz from a 0.9-V supply. Measurement results show that the complete authentication and key-establishment procedure consumes 11.48 {\textbackslash}mathrm{\textbackslash}mu J. The implemented protocol achieves a 1.4× increase in total energy efficiency compared to state-of-the-art cryptographic architecture implementing DTLS and the double ratchet protocol. The security and robustness of the hardware implementation are further assessed through circuit-level analysis of the CRPs-PUF. These analysis results demonstrate the suitability of the proposed protocol and hardware architecture for scalable and long-lifetime industrial IoT deployments.},
	urldate = {2026-07-26},
	journal = {IEEE Transactions on Industrial Informatics},
	author = {Ngo, Chi Trung and Tran, Sang and Pham, Van Khanh and Hong, Jong-Phil},
	year = {2026},
	keywords = {Authentication, Authentication protocol, challenge-response pair (CRPs) physical unclonable function (PUF), Cloning, Industrial Internet of Things, industrial Internet of Things (IIoT), Internet of Things, machine learning (ML) attacks, Modeling, Physical unclonable function, Protocols, Security, Servers, System-on-chip, system-on-chip (SoC)},
	pages = {1--12},
}

