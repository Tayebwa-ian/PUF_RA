	keywords = {cloning, Cloning, Delays, Field programmable gate arrays, FPGA, Integrated circuit modeling, machine learning, physical learning, Physical unclonable function, Physical unclonable functions, Protocols, Reliability, voltage drop sensor},
	pages = {1621--1632},
}

