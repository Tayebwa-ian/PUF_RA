	keywords = {CANDECOMP/PARAFACT tensor decomposition (CP-decomposition), Computational modeling, Data models, deep learning, Integrated circuit modeling, lightweight secure PUF (LSPUF), Machine learning, Mathematical model, modeling attacks, tensor regression networks (TRNs), Tensors, Training data, XOR arbiter PUF (XOR APUF)},
	pages = {1197--1206},
}

