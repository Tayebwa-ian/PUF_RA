	keywords = {adaptive frequency sweeping, Cloud computing, Clouds, Computer crashes, covert and efficient DoS attack, Field programmable gate arrays, FPGA cloud, hardware vulnerability, Monitoring, power and temperature-based resource adjustment, Security, Switching frequency, Temperature measurement, Temperature sensors, Time-frequency analysis},
	pages = {4641--4653},
}

