	keywords = {Architecture, Computer architecture, Degradation, Design methodology, EM Fault Injection, Entropy, Field programmable gate arrays, FPGA security, Frequency, Harmonic locking, Oscillators, Ring oscillator, Ring oscillators, Testing, TRNG},
