	note = {ISSN: 2836-3574},
	keywords = {cryptography, Encryption, Hardware security, Internet of Things, Internet-of- Things (IoT), Logistic regression, Physical unclonable function, physical unclonable function (PUF), Resistance, Resource management, Sensor systems, Sensors, Support vector machines, System-on-chip},
	pages = {173--176},
}

@inproceedings{thajte_tima-puf_2025,
