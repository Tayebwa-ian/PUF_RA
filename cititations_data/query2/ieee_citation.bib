	note = {ISSN: 2380-6923},
	keywords = {Autocorrelation, Delay lines, Hardware security, Inverter, Inverters, Jitter, key generation, Ring Oscillator, Vectors, Very large scale integration, VHDL},
	pages = {480--485},
}

