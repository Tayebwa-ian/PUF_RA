@inproceedings{wen_efficient_2017,
	title = {Efficient fuzzy extractor implementations for {PUF} based authentication},
	url = {https://ieeexplore.ieee.org/document/8323964/},
	doi = {10.1109/MALWARE.2017.8323964},
	abstract = {A strong security management of digital system should take all phases of lifecycle into consideration as the adversary can simply take advantage of the weakest link to compromise the systems, regardless of software, network, or hardware. As hardware devices are becoming more and more distributed and unsupervised, hardware security has emerged as an important challenge for cybersecurity. Various techniques have been developed recently to protect systems against malicious attacks from the hardware perspective. One promising hardware security primitive that can be used for authentication or identification is the physical unclonable function (PUF), which extracts chip-unique signatures from manufacturing process variations. However, as environmental variations could affect the characteristics of digital circuits, a PUF can hardly reproduce a consistent response. In the literature, error-correcting codes and fuzzy extractors are often used to correct the PUF errors before using the generated signature for authentication. This paper proposes novel architectures that incorporate different degrees of error-tolerance into PUF response correction to improve the efficiency of PUF-based authentication. One proposed fuzzy extractor implementation improves the reliability by eliminating high-entropy PUF response bits. An alternative method is to input low-entropy bits for authentication directly, while bypassing the error-correcting block. The security can be enhanced by employing this architecture, as the probability of a random guess that could pass the authentication is reduced, while the percentage of correctable keys only decreases slightly.},
	urldate = {2026-07-26},
	booktitle = {2017 12th {International} {Conference} on {Malicious} and {Unwanted} {Software} ({MALWARE})},
	author = {Wen, Yuejiang and Lao, Yingjie},
	month = oct,
	year = {2017},
	keywords = {Authentication, Delays, Entropy, Error correction, Reliability, Servers},
	pages = {119--125},
}

@inproceedings{li_puf-based_2025,
	title = {A {PUF}-{Based} {Adaptive} {Encrypted} {Communication} {Method} for {Firefighting} {IoT}},
	url = {https://ieeexplore.ieee.org/document/11360005/},
	doi = {10.1109/CITCE67565.2025.11360005},
	abstract = {With the rapid development of smart cities and the Internet of Things (IoT), the Firefighting IoT (FIoT) has become a key infrastructure for fire monitoring, early warning, and emergency response. However, FIoT devices typically suffer from constrained resources, long life cycles, and harsh operating environments, making conventional cryptographic schemes inefficient or difficult to maintain. Existing symmetric-key approaches rely on pre-stored secrets, while asymmetric and certificate-based methods impose excessive computational and management overhead.To address these challenges, this paper proposes a PUF-based adaptive encrypted communication method for FIoT systems. Physical Unclonable Functions (PUFs) are employed to enable lightweight device authentication and dynamic session key generation without long-term key storage, thereby reducing key leakage risks. A performance-aware adaptive mechanism is further introduced to quantify device capability based on real-time metrics, including available memory, CPU utilization, and energy level. According to predefined thresholdbased classification rules, devices are categorized into high-, medium-, or low-performance classes, which trigger dynamic selection of symmetric encryption algorithms, namely SM4, PRESENT, and Trivium. From a security perspective, the proposed scheme assumes a standard network attacker model and provides inherent resistance to replay attacks through one-time PUF challenge-response usage. By eliminating persistent secret keys, the method mitigates key extraction and modeling attacks, while the hardware-intrinsic properties of PUFs enhance robustness against physical and side-channel threats. In terms of scalability, the scheme supports lightweight device enrollment and revocation by managing PUF registration records at the platform, avoiding certificate management and frequent key updates, which is suitable for large-scale and long-lifecycle FIoT deployments.Compared with conventional fixed-algorithm schemes based on AES or SM4, as well as static lightweight encryption approaches, the proposed method achieves better adaptability to heterogeneous device capabilities while maintaining low computational overhead and real-time performance. The proposed framework provides a practical, scalable, and secure communication solution for firefighting IoT systems.},
	urldate = {2026-07-26},
	booktitle = {2025 5th {International} {Conference} on {Computer}, {Internet} of {Things} and {Control} {Engineering} ({CITCE})},
	author = {Li, Zhiru and Zhu, Haitao and Cheng, Jian and Duan, Xiaoyi and Dong, Liang},
	month = dec,
	year = {2025},
	keywords = {Adaptive Selection, Adaptive systems, Authentication, Cryptography, Encrypted Communication, Encryption, Firefighting IoT, Heuristic algorithms, Internet of Things, Lightweight, Performance evaluation, Physical unclonable function, Physical Unclonable Function, Real-time systems, Scalability},
	pages = {126--130},
}

@inproceedings{hayashi_is_2025,
	title = {Is {Digital} {Fault} {Sensor} {Secure} {Against} {Multiple} {Fault} {Injection}?: {A} {Case} {Study} on {Ro}-{Based} {LFI} {Sensor} {Against} {Double}-{Spot} {Laser} {Attack}},
	issn = {1946-1550},
	shorttitle = {Is {Digital} {Fault} {Sensor} {Secure} {Against} {Multiple} {Fault} {Injection}?},
	url = {https://ieeexplore.ieee.org/document/11256705/},
	doi = {10.1109/IPFA65338.2025.11256705},
	abstract = {Laser fault injection (LFI) is known as the most powerful fault attack due to its high precision and repeatability. Building sensor circuits on IC chips is one of the promising countermeasures to protect assets inside the IC chips from LFI. We focus on digital LFI sensors that can be built using only logic circuits. Digital LFI sensors indirectly monitor analog quantities such as voltage and temperature, which are perturbed by laser irradiation, via the signal delay fluctuation, and it has the advantage that it's easy to design and calibrate since it's completely composed of digital circuits such as ring oscillators. While sensors are a promising approach to countermeasures, their evaluation against multiple fault injection is still immature. This paper proposes a disturbance concealment attack (DCA) on digital LFI sensors, which prevents digital LFI sensors from detecting attacks using a dual-spot laser. The DCA analogously cancels the signal delay disturbance of one LFI by using the second LFI. We experimentally demonstrated that the proposed attack reduces the laser detection rate of a digital LFI sensor to 26.6\% and completely disables the sensor at some irradiation points. We also discuss the generality of the proposed method and its possible countermeasures.},
	urldate = {2026-07-26},
