	note = {ISSN: 2643-1971},
	keywords = {computational diversity, Computer architecture, cybersecurity, dynamic, Mission critical systems, Physical unclonable function, ReRAM, Resistive RAM, security, Sociology, Software, Statistics, ternary computation},
	pages = {1--6},
}

