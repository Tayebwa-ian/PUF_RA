	note = {ISSN: 1942-9401},
	keywords = {Aging, arbiter PUF, authentication, Authentication, Degradation, encryption, Logic gates, NBTI, Negative bias temperature instability, PBTI, Thermal variables control, Transistors},
	pages = {80--84},
}

