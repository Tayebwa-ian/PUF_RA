	keywords = {authentication, Authentication, Circuits, DDQ-APUF, Delays, Error correction codes, Field programmable gate arrays, FPGA, Integrated circuit reliability, Internet of Things, IoTs, Nonvolatile memory, Physical unclonable function, Quantization (signal), security},
