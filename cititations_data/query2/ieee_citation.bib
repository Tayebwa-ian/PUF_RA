	keywords = {Hardware, Machine learning, Machine Learning Attacks on PUFs, Measurement, Modeling Attacks on PUFs, Parametric statistics, Perturbation methods, Security Metrics, Sensitivity, Strong PUF Attacks, Strong PUF Security, Strong PUFs, Training},
	pages = {1--10},
}

