	keywords = {Bidirectional Associative Memory, Error Correcting Code, Error correction, Field programmable gate arrays, Field Programmable Gate Arrays, Multiplexing, Neural Network, Oscillators, Physically Unclonable Functions, Security, Supervised Learning, Table lookup, Vectors},
	pages = {330--333},
}

