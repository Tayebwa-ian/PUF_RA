@article{driemeyer_eye-opening_2026,
	title = {An {Eye}-{Opening} {Arbiter} {PUF} {With} {Auto}-{Error} {Detection} and {PVT}-{Robust} {Masking} {Achieving} a {BER} of 2e-8},
	volume = {61},
	issn = {1558-173X},
	url = {https://ieeexplore.ieee.org/document/11410529/},
	doi = {10.1109/JSSC.2026.3663673},
	abstract = {A hybrid ring oscillator (RO)/ arbiter physical unclonable function (PUF) is implemented in a 28-nm CMOS, where two competing ROs accumulate a sufficiently large phase difference exceeding a predefined deadzone (DZ). The resulting eye-opening arbiter (EOA) architecture enables a prediction of PUF bit stability over temperature change (from −40 °C to 125 $^{\textrm{{\textbackslash}circ }}$ C), supply voltage variation (±10\%), and four-year accelerated aging based on a single point measurement at the initial PUFs usage. This once-a-lifetime initialization at nominal conditions generates a blanking mask without disclosing secret PUF information, off-chip or even outside the PUF cells. The EOA architecture additionally features an inherent multi-purpose auto-error detection (AE-Detection), which allows to assess the reliability of every generated PUF bit at every PUF bit readout. Using AE-detection and masking, a bit error rate (BER) of 2 {\textbackslash}times 10$^{\textrm{-8}}$ over 16 measured devices and a total of 200 {\textbackslash}times 10⁶ measured bits over environmental changes and aging could be measured. The PUF operates with 0.259 pJ/bit, generates PUF bits with 4.515-Gbit/s bit-rate and only requires 34.84 {\textbackslash}mu {\textbackslash}text m{\textasciicircum}2 per bit, including all masking and stabilization circuitry, to ensure the low BER PUF performance.},
