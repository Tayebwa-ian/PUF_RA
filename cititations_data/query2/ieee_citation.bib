	keywords = {Computer architecture, Computer security, Crossover Ring Oscillator (CRO), Cybersecurity, Field programmable gate arrays, Hardware, Hardware Trojans, IoT, Logic, Physical unclonable function, Physically Unclonable Functions (PUFs), Protection, Resilience, Reverse engineering, Trojan horses},
	pages = {1--6},
}

