	keywords = {Arbiter-PUF, Electrical resistance measurement, Electromagnetics, Field programmable gate arrays, FPGA security, Manufacturing, Physical unclonable function, Physical Unclonable Functions, Pulse measurements, Pulsed EM fault injection, Resilience, Resistance, Scalability, Time measurement},
	pages = {385--393},
}

