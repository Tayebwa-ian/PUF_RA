	keywords = {Aerospace electronics, Capacitor, Capacitors, challenge-response pair (CRP), Entropy, Frequency measurement, hardware security, Internet of Things, Inverters, Physical unclonable function, physical unclonable function (PUF), ring oscillator, Ring oscillators, System-on-chip, temperature compensation, Temperature measurement},
	pages = {54816--54829},
}

@article{zhang_physical_2020,
