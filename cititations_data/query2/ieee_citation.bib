	keywords = {Accuracy, Bent function, Cryptography, Delays, Feistel network, Hardware, Integrated circuit modeling, Internet of Things, modeling attack, nonlinearity (NL), Physical unclonable function, physical unclonable function (PUF), Prediction algorithms, Resistance, Vectors},
