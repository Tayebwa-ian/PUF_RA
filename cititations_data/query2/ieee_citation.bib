	keywords = {countermeasure to helper data manipulation., Delays, Entropy, Error correction codes, Filtering, helper data, high entropy, high reliability, Reliability, Security, Strong PUF},
	pages = {184--188},
}

@inproceedings{garb_attacks_2021,
	title = {Attacks and {Countermeasures} for {Capacitive} {PUF}-{Based} {Security} {Enclosures}},
	url = {https://ieeexplore.ieee.org/document/9707704/},
	doi = {10.1109/PAINE54418.2021.9707704},
	abstract = {Protecting embedded devices from tampering is a difficult task since the attacker can perform manipulations through physical access. To provide a security barrier for protection, envelopes based on Physical Unclonable Functions (PUFs) have been developed. Their PUF emerges from, for example, a mesh of electrical capacitors embedded in the envelope. Even though these envelopes have several advantages over existing battery-backed solutions, it has been shown that they are susceptible to micro-drilling and bypassing attacks, where the capacitances and thereby the PUF secret can be extracted unnoticed.We harden the security of the capacitive PUF-based enclosure by presenting the three most impactful hardware attacks and proposing practical countermeasures for micro drilling, bypassing, and magnetic probing. We analyze the impact of drilling attacks with small diameters {\textless}{\textless}300 μm, and discuss additional countermeasures. We also propose a hardware countermeasure for the previously published bypassing attack. Furthermore, we conduct an H-probe attack on the magnetic field permeating the envelope’s shielding where we show, in practice as well as through Finite Element Analysis (FEA), that intercepting the transmission of digitized PUF-responses is practically feasible. As a countermeasure, we extend our PUF evaluation system by cryptographic security measures to ensure confidentiality.Our discussion of attacks and the development of counter-measures brings PUF-based security enclosures an important step forward towards their practical applications in the next generation of high security systems.},
	urldate = {2026-07-26},
	booktitle = {2021 {IEEE} {Physical} {Assurance} and {Inspection} of {Electronics} ({PAINE})},
	author = {Garb, Kathrin and Schink, Marc and Hiller, Matthias and Obermaier, Johannes},
	month = nov,
	year = {2021},
	keywords = {bypassing, capacitive enclosure, Drilling, Hardware, Magnetic noise, magnetic probing, micro drilling, Performance evaluation, Physical unclonable function, Physical Unclonable Function, Security, Task analysis},
	pages = {1--8},
}

@inproceedings{jyothi_development_2025,
	title = {Development of {Secure}-by-{Design} {RISC}-{V} {Architectures} with {Embedded} {Hardware} {Roots}-of-{Trust} for {Next}-{Generation} {Smart} {Devices}},
	url = {https://ieeexplore.ieee.org/document/11385713/},
	doi = {10.1109/IETACS68750.2025.11385713},
	abstract = {The ever-growing spread of smart devices in safety-critical areas like healthcare, industry, and defence has accentuated the demand for safe, dependable computing platforms. In this paper, we propose ANCHOR-RV, a novel secure-by-design RISC-V ISA that incorporates embedded hardware Roots of Trust (RoT) to overcome the shortcomings of traditional security models. In contrast to the current solutions based on fixed trust anchors and inflexible boot mechanisms, ANCHOR-RV proposes an amazingly flexible and dynamic security system comprised of a Context-Aware Trust Engine (CATE), a Nonlinear PUF-Enhanced Identity Vault, a Secure DMA Isolation Bubble (SDIB) and a Trust-Aware Boot Chain with Mutation (TAB-CM). In combination, these modules can offer real-time threat monitoring, per-device identity verification, secure peripheral isolation, and highstrength boot integrity, and are enhanced by a custom RISC-V ISA extension (RV-TISA) to support more secure firmware-software communication. ANCHOR-RV enables the self-configuration of intelligent devices to dynamically changing threat situations with a minimal power and space footprint, making it particularly useful for prototyping and simulation in low-resource environments. The architecture is prototyped and simulated with the FPGA to test its security robustness, performance and efficiency. The experimental data convincingly show that ANCHOR-RV can deliver significant improvements in trust flexibility and attack resistance, and that it is more efficient than traditional constant RoT deployments in dynamic environments. Mutation of the boot mechanism employed in the architecture and context-aware trust management provides a new defence against side-channel attacks, persistent threats, and boot-time attacks. The work will lay the foundation for future resilient RISC-V-based computing systems, enabling a flexible, extensible, and resilient next-generation smart device platform. The subsequent steps will include an ASIC implementation, optimisation of the machine learning models, and integration with real-world smart device platforms.},
	urldate = {2026-07-26},
	booktitle = {2025 {International} {Conference} on {Innovations} and {Emerging} {Technologies} {In} {AI} \& {Communication} {Systems} ({IETACS})},
	author = {Jyothi, Dola and Naik, M. Nagaraju and Narayan, S. Mallesh and Chari, K Subramanayam},
	month = nov,
	year = {2025},
	keywords = {Computer architecture, Context-Aware Security, Embedded System Security, Field programmable gate arrays, FPGA Prototyping, Hardware, Hardware Root of Trust, Next generation networking, Resistance, RISC-V Architecture, Runtime, Secure Boot Mechanism, Security, Side-Channel Attack Resistance, Side-channel attacks, Smart devices, Testing},
	pages = {1265--1271},
}

@article{liu_multiclass_2022,
	title = {Multiclass {Classification}-{Based} {Side}-{Channel} {Hybrid} {Attacks} on {Strong} {PUFs}},
	volume = {17},
	issn = {1556-6021},
	url = {https://ieeexplore.ieee.org/document/9732975/},
	doi = {10.1109/TIFS.2022.3152393},
	abstract = {Physical unclonable functions (PUFs) are promising solutions for low-cost device authentication; hence, ignoring the security of PUFs is becoming increasingly difficult. Generally, strong PUFs are vulnerable to classical machine learning (ML) attacks; however, classical ML attacks do not perform well on strong PUFs with complex structures. Side-channel analysis (SCA) hybrid attacks provide efficient approaches to modeling XOR APUF. However, owing to the inadequate exploitation of all available data, recent SCA hybrid attacks may fail on novel PUF designs, such as MPUF and iPUF. Thus, herein, we introduce a method that combines challenge-response pairs with side-channel information to construct challenge-synthetic-feature pairs (CSPs) via feature cross, thereby making it possible to model strong PUFs through multiclass classification. We propose multiclass classification-based SCA hybrid attacks to model strong PUFs with complex structures. When provided with CSPs, the proposed hybrid attacks use a feed-forward neural network with a softmax activation function to build combined models of PUFs. The combined models predict class labels for given challenges and then reveal responses through simple mappings from these labels. Experimental results show that the proposed attacks could model 16-XOR APUF, (128,5)-MPUF, (8,8)-iPUF, and (2,16)-iPUF with accuracies exceeding 94\%. Compared with state-of-the-art modeling techniques, the proposed attack has advantages in terms of modeling accuracy, time cost, and the size of required training data.},
	urldate = {2026-07-26},
	journal = {IEEE Transactions on Information Forensics and Security},
	author = {Liu, Wei and Wang, Ruiming and Qi, Xuyan and Jiang, Liehui and Jing, Jing},
	year = {2022},
	keywords = {Analytical models, Complexity theory, Data models, feed-forward neural network, Mathematical models, multiclass classification, Neural networks, Physical unclonable function, Reliability, Security, side-channel analysis, synthetic feature},
	pages = {924--937},
}

