@article{hassan_tease_2026,
	title = {{TEASE}: {A} {Leak}-{Resilient} {Strong} {PUFs} {Construction} via {Statistically} {Deficient} {Data} {Release}},
	volume = {21},
	issn = {1556-6021},
	shorttitle = {{TEASE}},
	url = {https://ieeexplore.ieee.org/document/11570910/},
	doi = {10.1109/TIFS.2026.3705335},
	abstract = {The security of light-weight and implementation-friendly PUF candidates is frequently deemed insufficient due to the presence of modeling attacks that can infer the PUF response model when presented with (leaked) challenge-response pairs (CRPs) using machine learning primitives such as classification. However, closer inspection reveals that the attacks critically rely on the popular assumption of PAC learning that the leaked CRPs (often chosen randomly) are a representative subsample of the entire CRP population. This raises the question whether these PUF candidates could have provided greater security had the CRPs been chosen more carefully instead of randomly. The core contribution of this work is the {\textbackslash}textsf TEASE algorithm that answers this question in the affirmative. It is first demonstrated that large CRP sets exist that, even if leaked to an adversary, yield a provably small amount of information about the response model of the underlying PUF. To discover such CRP sets, a scalable algorithm based on the optimization technique of bilevel programming is proposed. {\textbackslash}textsf TEASE forces ML attacks to be content with a prediction accuracy of around 50\% on non-leaked CRPs, comparable to random guessing. {\textbackslash}textsf TEASE can gracefully tolerate multiple rounds of CRP leaks, offer resistance against powerful divide-and-conquer attacks such as the splitting attack, all while having a lower hardware overhead than existing countermeasures. As a proof of concept, extensive experiments are carried out establishing that {\textbackslash}textsf TEASE confers resistance against ML attacks by linear (SVM, LR) and non-linear models (gradient-boosted decision trees, neural networks etc.) for a variety of lightweight PUF architectures such as Arbiter PUF, XOR-PUF, XRBR PUF, XRRO PUF, and Interpose PUF even when up to 30K CRPs are leaked. We believe that algorithms such as {\textbackslash}textsf TEASE pave the way for several more application areas to benefit from lightweight “Strong PUF candidates.”},
	urldate = {2026-07-26},
	journal = {IEEE Transactions on Information Forensics and Security},
	author = {Hassan, Neelofar and Shah, Kush and Chatterjee, Urbi and Kar, Purushottam},
	year = {2026},
	keywords = {Accuracy, Authentication, bi-level programming, Conferences, Machine learning, machine learning attack, Modeling, numerical optimization, Optimization, Physical unclonable function, Physically unclonable functions, Security, Training, Vectors},
	pages = {6575--6588},
}

