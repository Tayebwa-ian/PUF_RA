	urldate = {2026-07-26},
	journal = {IEEE Internet of Things Journal},
	author = {Masud, Mehedi and Gaba, Gurjot Singh and Alqahtani, Salman and Muhammad, Ghulam and Gupta, B. B. and Kumar, Pardeep and Ghoneim, Ahmed},
	month = nov,
