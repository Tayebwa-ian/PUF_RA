	keywords = {challenge obfuscation, Delays, Hardware, machine learning (ML), Mathematical models, modeling attack, Physical unclonable function, Physical unclonable function (PUF), reverse engineering (RE), Security, symmetrical obfuscated interconnection (SOI), Training, Vectors},
