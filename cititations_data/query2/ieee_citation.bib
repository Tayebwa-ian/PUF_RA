@article{liu_373-f2_2020,
	title = {A 373-{F2} 0.21\%-{Native}-{BER} {EE} {SRAM} {Physically} {Unclonable} {Function} {With} 2-{D} {Power}-{Gated} {Bit} {Cells} and {V}\_{\textbackslash}{textSS} {Bias}-{Based} {Dark}-{Bit} {Detection}},
