@inproceedings{li_enhancing_2025,
	title = {Enhancing {Dilithium} with {CBDC}-{PUF}: a post-quantum secure signature scheme resilient to hardware attacks},
	volume = {2025},
	shorttitle = {Enhancing {Dilithium} with {CBDC}-{PUF}},
	url = {https://ieeexplore.ieee.org/document/11237296/},
	doi = {10.1049/icp.2025.3565},
	abstract = {To address the threat that quantum computers may potentially break the existing public-key cryptosystems, developing new quantum attack-resistant schemes has become increasingly critical. Although the lattice-based post-quantum cryptography standard Dilithium algorithm can provide a high level of security, it may still be vulnerable to hardware-level attacks such as side-channel analysis and physical cloning. To this end, this paper proposes an innovative scheme that combines the Configurable Butterfly Delay Chain Physical Unclonable Function (CBDC-PUF) with the Dilithium algorithm to enhance hardware security. The scheme fully utilizes the inherent physical randomness of CBDC-PUF to realize key generation and device authentication, which can effectively resist modeling attacks, side-channel attacks, and physical cloning. Experimental results show that while maintaining the cryptographic strength of the Dilithium algorithm, this integrated scheme can significantly improve the security and performance of the system. By optimizing resource allocation to reduce hardware overhead, the scheme is particularly suitable for systems with high requirements for both security and performance.},
