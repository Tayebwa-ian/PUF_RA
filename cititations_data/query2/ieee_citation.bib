	keywords = {Analog/mixed-signal (AMS), Consumer electronics, counterfeit detection, Counterfeiting, IC assurance, IC security, Integrated circuits, LDO, LDO-based Odometer, logic obfuscation, Odometers, Physical unclonable function, physical unclonable function (PUF), Security, Supply chains, threshold voltage defined (TVD) logic},
