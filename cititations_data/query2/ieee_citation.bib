	url = {https://ieeexplore.ieee.org/document/9531778/},
	doi = {10.1109/MWSCAS47672.2021.9531778},
	abstract = {The side-channel attack can extract sensitive information from secure data handling devices. Various logical and circuit-level countermeasures have been proposed in recent works to increase the immunity of encryption devices. Recent work on a switched-capacitor (SC) based power side-channel attack (PSCA) detection presents a more generic and computation-efficient method than machine learning (ML) based or ring oscillator (RO)-based prior arts. However, the performance limitation of this new method due to internal circuit noise remains unknown. This paper presents the first noise analysis on the SC-based PSCA detection circuits. A direct relationship is established between the minimum detectable resistance and the circuit noise, and the system’s power consumption. Guided by this relationship, the original SC-based PSCA detection circuits’ energy efficiency was improved by 23x while maintaining similar detection time and accuracy performance.},
	urldate = {2026-07-26},
