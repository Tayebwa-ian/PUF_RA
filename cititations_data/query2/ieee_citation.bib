@inproceedings{vijayalakshmi_design_2026,
	title = {Design and {Analysis} of a {Robust} {RO}-{PUF} for {Enhanced} {Security}},
	url = {https://ieeexplore.ieee.org/document/11584852/},
	doi = {10.1109/ICIETSD68684.2026.11584852},
	abstract = {Secure and trustworthy hardware is a fundamental requirement for modern electronic systems, especially in the context of Cyber Physical Systems. The proposed Ring Oscillator (RO)-based Physically Unclonable Function (PUF) serves as a hardware security primitive that produces a unique and unclonable digital identity. The design consists of a large array of RO circuits, each oscillating at a slightly different frequency due to the physical variations. A proposed frequency counter measures these oscillation rates. A multiplexer network selects specific {\textbackslash}mathbfR O pairs to form Challenge-Response Pairs (CRPs), which constitute the unique fingerprint of the design. To improve its reliability, the system incorporates a majority-voting mechanism. Additionally, an XOR-based post-processing stage enhances randomness, uniformity, and resistance against various attacks. The results clearly indicate that the proposed system offers enhanced security and well-suited for cryptographic key generation in IoT systems.},
	urldate = {2026-07-26},
