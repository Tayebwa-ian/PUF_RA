	keywords = {Challenge Response Pair (CRP), Crossover, Cryptography, Inverters, Manufacturing processes, NIST, Physical unclonable function, Physically Unclonable Function (PUF), Randomness, Ring Oscillator (RO), Ring oscillators, Silicon},
	pages = {200--203},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\Y4TJZQ2Z\\Amin et al. - 2022 - Design of a Highly Randomized Crossover Ring Oscillator Physical Unclonable Function.pdf:application/pdf},
