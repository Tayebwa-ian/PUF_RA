@inproceedings{shivani_stateless_2026,
	title = {Stateless {AES} {Key} {Generation} via {Graph} {Neural} {Network}–{Driven} {Deterministic} {Physical} {Unclonable} {Intelligence}},
	url = {https://ieeexplore.ieee.org/document/11608331/},
	doi = {10.1109/IC3SIS69949.2026.11608331},
	abstract = {The security of the Advanced Encryption Standard (AES),critically dependent on secret key protection; however, persistent key storage remains a fundamental vulnerability in cloud, mobile and edge systems, enabling leakage, replay, and unauthorized access. This paper presents a stateless biometric-driven cryptographic framework that eliminates the need for key storage by generating AES-compatible keys directly from fingerprint data. The approach is based on a deterministic physical unclonable identity (D-PUI), where fingerprint minutiae are represented as graph-structured data. Using Graph Neural Networks (GNNs), the system captures stable and distinctive topological features to produce high-entropy cryptographic keys. Unlike traditional biometric or PUF-based methods, this framework does not rely on stored keys, templates, or helper data, while still maintaining consistent key generation and strong uniqueness between users. In addition, a well-defined threat model is considered to ensure resistance to spoofing, replay, and side-channel attacks. The system also supports a consent-based, privacy-preserving re-authentication mechanism, making it suitable for secure and user-centric applications. The experimental evaluation achieves 98.7 \% key reproducibility with low latency (36 {\textbackslash}mathrm ms). The framework establishes a scalable paradigm for storage-free secure key generation in privacy-critical edge and IoT environments.},
	urldate = {2026-07-26},
	booktitle = {2026 {International} {Conference} on {Computing}, {Communication}, {Security} and {Intelligent} {Systems} ({IC3SIS})},
	author = {Shivani, B S and Hari Prasad, V and Brindha, J. and Subbulakshmi, A. and Maragathavalli, P. and R, Ramyashree},
	month = may,
