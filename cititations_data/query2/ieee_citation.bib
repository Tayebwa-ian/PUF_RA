@article{faour_tmvs_2026,
	title = {{TMVS}: {Threshold}-{Based} {Majority} {Voting} {Scheme} for {Robust} {SRAM} {PUFs}},
	volume = {21},
	issn = {1556-6021},
	shorttitle = {{TMVS}},
	url = {https://ieeexplore.ieee.org/document/11494079/},
	doi = {10.1109/TIFS.2026.3687093},
	abstract = {SRAM Physically Unclonable Functions (PUFs) derive secret keys from start-up values for inherent security benefits but suffer from reliability issues due to bit flipping. We introduce the Threshold-based Majority Voting Scheme (TMVS), a lightweight method that eliminates noise and mitigates bias in SRAM PUFs while retaining the simplicity of majority voting decoders used by repetition codes, without the significant entropy loss that repetition codes incur under biased responses. TMVS runs entirely in software, requires no cell-level bit-error rate qualification or SRAM redesign, and avoids the complex decoders of heavy error correcting codes. We derive closed-form expressions for decoding-error probability and expected memory, validate them on experimental data, and present a security analysis that provides exact formulas for min-entropy and secrecy leakage due to helper data and bias, identifying conditions under which TMVS achieves zero secrecy leakage. On a large public dataset, TMVS shows near-zero cross-chip secrecy leakage and preserves average conditional min-entropy above 1 bit despite biased, spatially correlated SRAM statistics. Compared with prior work, TMVS offers the smallest decoding complexity at the cost of a larger PUF size. In a representative configuration, TMVS generates a 128-bit key with failure probability {\textbackslash}mathbf 9.15 {\textbackslash}cdot 10{\textasciicircum}-7 and zero secrecy leakage at a bit-flip probability of 10\%, requiring only {\textbackslash}sim {\textbackslash}mathbf 248 k clock cycles on a 32-bit ARM Cortex-M0. These results show that TMVS is practical and implementation-friendly for resource-constrained, low-power devices.},
	urldate = {2026-07-27},
	journal = {IEEE Transactions on Information Forensics and Security},
	author = {Faour, Sara and Maksimovic, Filip and Burnett, David C. and Muhlethaler, Paul and Watteyne, Thomas and Pister, Kristofer and Vučinić, Mališa},
	year = {2026},
	keywords = {Circuits, Circuits and systems, Filtering, Frequency modulation, Integrated circuits, Microcontrollers, Microprocessors, Radio broadcasting, reliability, secrecy leakage, secret key, SRAM PUF, System-on-chip, Very large scale integration},
	pages = {4846--4861},
}

