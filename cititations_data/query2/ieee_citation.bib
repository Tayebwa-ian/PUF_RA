@article{zhang_highly_2015,
	title = {Highly {Reliable} {Spin}-{Transfer} {Torque} {Magnetic} {RAM}-{Based} {Physical} {Unclonable} {Function} {With} {Multi}-{Response}-{Bits} {Per} {Cell}},
