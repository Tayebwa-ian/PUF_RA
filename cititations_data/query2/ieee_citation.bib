	urldate = {2026-07-26},
	journal = {IEEE Journal of Solid-State Circuits},
	author = {Driemeyer, Bjoern and Mandry, Holger and Wiens, David-Peter and Kauffman, John G. and Becker, Joachim and Ortmanns, Maurits},
	month = aug,
	year = {2026},
	keywords = {Auto-error detection (AE-Detection), Bit error rate, blanking mask, Computer architecture, Fingerprint recognition, hardware security, Physical unclonable function, physical unclonable function (PUF), Stability analysis, Standards, Temperature dependence, Temperature distribution, Temperature measurement, Thermal stability},
	pages = {4295--4307},
}

