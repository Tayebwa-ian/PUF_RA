	abstract = {Malicious terminals that illegally access the 5G power service network can steal or tamper with the sensitive information of the power system. However, research on how to ensure the identity legitimacy of lightweight 5G reduced capability (RedCap) terminals and further enhance the security of the 5G channel side in the power sector remains insufficient. To address this gap, this article proposes a low-cost secondary authentication protocol based on physical unclonable function (PUF) hardware chips. First, a grid-oriented 5G security architecture and a system model for RedCap terminal authentication are established. Second, aiming at the challenge that resource-constrained terminals struggle to support traditional cryptographic protocols, a lightweight secondary authentication scheme and a confidential identity database scheme are proposed. These schemes are built on the PUF and a lightweight encryption algorithm, with the integration of “primary–secondary” dual PUF chips. Finally, the proposed schemes are analyzed and validated through security software evaluation and hardware terminal testing. The results demonstrate two key advantages. In terms of effectiveness, compared with similar schemes, the proposed scheme reduces computation costs by 75\%–80\%, communication costs by 20\%–50\%, and the cost of RedCap terminals by approximately 60\%. In terms of reliability, besides resisting basic attacks, it also effectively defends against ephemeral secret leakage (ESL) attacks, modeling attacks, and stolen verifier attacks, among others.},
	number = {12},
	urldate = {2026-07-26},
	journal = {IEEE Internet of Things Journal},
	author = {Chen, Zhixiong and Wang, Meiying and Li, Yong and Shao, Weiping and Qiu, Jinyi},
	month = jun,
	year = {2026},
	keywords = {5G, 5G mobile communication, Authentication, Costs, Internet of Things, Physical unclonable function, physical unclonable functions (PUFs), Power system stability, Power systems, Protocols, reduced capability (RedCap), secondary authentication, Security, Smart grids},
	pages = {26456--26469},
}

@inproceedings{hadayeghparast_-differential_2025,
	title = {On-die {Differential} {Sensing} for {Monitoring} and {Analysis} of {Dynamic} {Computing} {Environments}},
	issn = {2158-1525},
	url = {https://ieeexplore.ieee.org/document/11043441/},
	doi = {10.1109/ISCAS56072.2025.11043441},
	abstract = {With increasing popularity of cloud FPGAs and future multi-tenant usage, security threats are posed including on-die side channel attacks, fault injection or denial of service caused by power wasting circuits. Monitoring FPGA circuit activity with sensors is a common technique used by attackers and defenders. Combining data from multiple sensors makes it possible to pinpoint power wasting circuits, but with limited precision. In this paper we demonstrate how a network of sensors and differential analysis can together increase robustness of monitoring, making it possible to determine the location of target circuits even if their power consumption is relatively low. The sensors are ring oscillator (RO) or time-to-digital converter (TDC) circuits that collect timeseries information of the local voltage at different FPGA points. The sensor data and knowledge of when target circuits are active, enables the differential analysis technique that boosts the sensitivity beyond that of prior works. We analyze how the performance varies with sensor coverage and circuit parameters and show how a pre-characterization procedure can further improve accuracy over uncalibrated analysis.},
	urldate = {2026-07-26},
	booktitle = {2025 {IEEE} {International} {Symposium} on {Circuits} and {Systems} ({ISCAS})},
