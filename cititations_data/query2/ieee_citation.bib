	doi = {10.1109/CI2A69097.2026.11576926},
	abstract = {Internet of Medical Things (IoMT) is a quickly developing kind of modern healthcare, allowing to monitor patients remotely and analyze the data in real-time. Exponential growth of inter-connected medical devices, however, has created a paradox of critical security: although strong security is needed to guarantee protection of sensitive physiological data, standard security protocols including traditional Zero Trust frameworks and heavy cryptography requirements, are frequently computationally infeasible on resource-constrained hardware. Implantable sensors and wearables, often with small battery capacities ({\textless}500 {\textbackslash}textmAh) and cheap microcontrollers, have a high potential of uncontrollable failure when subjected to constant authentication. This paper gives an in-depth overview of lightweight Zero Trust architectures and energy-efficient protocols that were published between 2024 and 2025 with the sole purpose of alleviating this bottleneck. We take a look at the recent developments in lightweight cryptography (such as SPECK and Montgomery Ladder-optimized ECC), security that uses hardware assistance (Physical Unclonable Functions) and adaptable system architecture. We find that our comparative study shows that with the transition to optimized algorithms like SPECK the energy consumption can be as low as 1.68 mWh per session and novel system-level structures like SEES-IoMT show a 29\% lowering of the total network energy consumption than state of the art approaches. We conclude that the future of secure IoMT is hybrid solutions that unite lightweight algorithms with edge intelligence so that the integrity of data can be ensured without having adverse effects on the performance of the devices.},
	urldate = {2026-07-27},
	booktitle = {2026 {International} {Conference} on {Connected} {Intelligence} for {Industrial} {Applications} ({CI2A})},
	author = {Sharma, Anurag and Jangwal, Tarun},
	month = apr,
