	keywords = {Authentication, Computer architecture, Cryptography, FPGA, Hardware security and trust, Internet of Things, Mathematical model, Microprocessors, Physically Inclinable Functions, Protocols},
	pages = {563--567},
}

@inproceedings{choden_konigsmark_system--pufs_2014,
