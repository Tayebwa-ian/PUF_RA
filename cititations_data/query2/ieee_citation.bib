	keywords = {advanced encryption standard (AES), Integrated circuits, Machine learning, machine learning attacks, Physical unclonable function (PUF), side-channel attacks, Side-channel attacks, Silicon, Training},
	pages = {1--5},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\3KV3TLYK\\Wen et al. - 2019 - A Novel PUF Architecture Against Non-Invasive Attacks.pdf:application/pdf},
