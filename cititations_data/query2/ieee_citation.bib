	keywords = {Computational modeling, Data models, Deep learning, Hardware, Intellectual property, Intellectual Property, Model Stealing Attacks, Physical unclonable function, Physical Unclonable Functions, Protection, Software, Software development management, Transformer, Transformers},
	pages = {956--972},
}

