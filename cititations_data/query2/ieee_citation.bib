	urldate = {2026-07-27},
	journal = {IEEE Transactions on Computer-Aided Design of Integrated Circuits and Systems},
	author = {Gao, Yansong and Yao, Jianrong and Pang, Lihui and Yang, Wei and Fu, Anmin and Al-Sarawi, Said F. and Abbott, Derek},
