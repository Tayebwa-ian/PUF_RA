	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\WWYG3LGP\\Vijayalakshmi et al. - 2026 - Design and Analysis of a Robust RO-PUF for Enhanced Security.pdf:application/pdf},
