	booktitle = {2013 {IEEE} 21st {Annual} {International} {Symposium} on {Field}-{Programmable} {Custom} {Computing} {Machines}},
	author = {Zhang, Jiliang and Lin, Yaping and Lyu, Yongqiang and Cheung, Ray C.C. and Che, Wenjie and Zhou, Qiang and Bian, Jinian},
	month = apr,
	year = {2013},
	keywords = {binding hardware designs to specific FPGA device, Cryptography, Databases, Educational institutions, Field programmable gate arrays, field-programmable gate array (FPGA), finite state machine (FSM), Hardware, intellectual property (IP) protection, Licenses, physically unclonable functions (PUFs), Protocols},
	pages = {227--227},
}

