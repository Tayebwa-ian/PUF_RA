	month = oct,
	year = {2014},
	keywords = {checker, Equations, injection of fake objects, non-repudiation, NRS, privacy, Privacy, protocol, Protocols, PUF, Radiofrequency identification, RFID, Security, Supply chains, unclonable},
	pages = {78--83},
}

@article{xie_multiserver_2025,
	title = {A {Multiserver} {Authentication} {Protocol} {With} {Integrated} {Monitoring} for {IoMT}-{Based} {Healthcare} {System}},
