	keywords = {authentication, Authentication, Costs, Measurement, performance evaluation, Protocols, Reviews, smart grid, Smart grids, Wireless communication},
	pages = {1--4},
}

@inproceedings{asha_generation_2018,
	title = {Generation of {PUF}-{Keys} on {FPGAs} by {K}-means {Frequency} {Clustering}},
	url = {https://ieeexplore.ieee.org/document/8607174/},
	doi = {10.1109/AsianHOST.2018.8607174},
	abstract = {Physical unclonable functions (PUFs) generate secret keys that are unique and derived from the manufacturing process variations of the device. For high-security applications, generating the keys on the device is more secure than storing it on the device due to its resistance to attacks like tampering, probing and side-channel attacks. Also, the PUF-key generated should be very unique and reliable. In this paper, we are proposing a novel technique of generating a Ring Oscillator (RO) based PUF-keys on FPGAs by K-means clustering of RO frequencies. The placement of ROs on the FPGA fabric will have an impact on the variation of their oscillating frequencies. Based on the similarities in their frequency variations, the RO frequencies are grouped into k-clusters by K-means clustering and, the comparison of within-cluster RO frequencies will generate the PUF-keys. Our proposed method is evaluated on a large population of 193 Xilinx Spartan FPGAs. With the proposed method, the average inter-die Hamming Weight of the PUF responses is 48.92\% which is close to the ideal value of 50\%, the average Hamming Weight of the n-bit PUF response is 49.90\% and the average error rate due to changes in temperature and voltage is 3.43\%.},
	urldate = {2026-07-26},
	booktitle = {2018 {Asian} {Hardware} {Oriented} {Security} and {Trust} {Symposium} ({AsianHOST})},
	author = {Asha, K A and Patyal, Abhishek and Chen, Hung-Ming},
	month = dec,
	year = {2018},
	keywords = {Field programmable gate arrays, FPGA, K-means Clustering, Manufacturing processes, PUF, Reliability, Ring Oscillator (RO), Ring oscillators, Security, Systematics},
	pages = {44--49},
}

@inproceedings{mehjabin_pama_2025,
	title = {{PAMA}: {PUF}-based {Aggregated} {Multi}-hop {Attestation} {Protocol} for {IoT}},
	issn = {1938-1883},
	shorttitle = {{PAMA}},
	url = {https://ieeexplore.ieee.org/document/11161539/},
	doi = {10.1109/ICC52391.2025.11161539},
	abstract = {An Internet of Things (IoT) engages a large number of resource-constrained edge devices that are internetworked over multi-hop paths. Remote attestation refers to checking the integrity of the software onboard the individual devices (provers) to ensure that it is not maliciously tampered with. Given the scale and the lack of direct communication links, attestation often needs to be conducted over a multi-hop path between a verifier and a prover which raises concern about the integrity and confidentiality of the provided response (digest). To address these issues, this paper proposes PAMA a lightweight attestation protocol utilizing Physical Unclonable Functions (PUFs) to obfuscate the digest and sustain its confidentiality. PAMA does not reveal the actual digest and deprive any node on the dissemination path from even replaying an old attestation response. The response of multiple provers is further aggregated to improve efficiency and scalability while enabling the verifier to authenticate the devices on the path and determine which of them has failed the digest validation if any. PAMA's robustness is rigorously analyzed, and its performance is validated through simulation. The results show that PAMA outperforms competing schemes in terms of runtime complexity, bandwidth efficiency and energy consumption.},
	urldate = {2026-07-26},
	booktitle = {{ICC} 2025 - {IEEE} {International} {Conference} on {Communications}},
	author = {Mehjabin, Suhee Sanjana and Younis, Mohamed},
	month = jun,
	year = {2025},
	note = {ISSN: 1938-1883},
	keywords = {Attestation, Internet of Things, Network Security, Performance evaluation, Physical unclonable function, Physical Unclonable Function, Protocols, Robustness, Runtime, Scalability, Software, Software integrity, Spectral efficiency, Spread spectrum communication},
	pages = {722--727},
}

