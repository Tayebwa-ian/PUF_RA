	keywords = {Circuits, Delays, Field programmable gate arrays, Hardware security, Integrated circuit modeling, Internet of Things, modeling attacks, Physical unclonable function, physical unclonable function (PUF), Resistance, Resists, Reverse engineering, Security},
	pages = {2395--2407},
}

