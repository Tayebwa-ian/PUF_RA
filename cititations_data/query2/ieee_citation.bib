	keywords = {Architecture, Computer architecture, Energy, energy efficiency, healthcare 4.0, internet of medical things (IOMT), lightweight cryptography, Medical services, Modeling, physical unclonable functions (PUF), Poles and zeros, Printing, Protocols, Security, Zero Trust, zero trust architecture (ZTA)},
	pages = {1--6},
}

