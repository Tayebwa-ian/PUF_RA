	author = {Rincón, Alvaro E. R. and Melo, Wilson S. and de Farias, Claudio Miceli and Carmo, Luiz F. Rust C.},
	year = {2021},
	keywords = {Hardware, Hardware protection, Meters, physical context (PC), Physical unclonable function, physical unclonable function (PUF), physical-based identities, Random access memory, Security, Smart meters, smart meters security, Software},
	pages = {1--11},
}

