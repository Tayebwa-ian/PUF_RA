	title = {A {Security}-{Enhanced}, {Charge}-{Pump}-{Free}, {ISO14443}-{A}-/{ISO10373}-6-{Compliant} {RFID} {Tag} {With} 16.2-μ{W} {Embedded} {RRAM} and {Reconfigurable} {Strong} {PUF}},
