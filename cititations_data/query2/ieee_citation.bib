	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\8GEH4PML\\Loong et al. - 2016 - Performance analysis of CMOS-memristor hybrid ring oscillator Physically Unclonable Function (RO-PUF.pdf:application/pdf},
