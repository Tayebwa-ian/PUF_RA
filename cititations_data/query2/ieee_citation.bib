	keywords = {Anonymity, authentication, Authentication, Cryptography, lightweight, physically uncloneable functions (PUFs), Privacy, Protocols, radio frequency identification (RFID), Radiofrequency identification, Servers},
	pages = {2831--2843},
}

@inproceedings{al-haidary_physically_2019,
