	note = {ISSN: 1946-1488},
	keywords = {Clocks, Cloud computing, cloud FPGAs, covert channels, crosstalk, Delays, Field programmable gate arrays, long wire leakage, ring oscillators, Ring oscillators, side channels, Wires},
	pages = {45--50},
}

