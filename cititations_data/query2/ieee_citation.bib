	keywords = {cryptographic devices, Hardware Security, Machine learning, Minimum detectable resistance, Performance evaluation, Power analysis attack, Power demand, Resistance, Ring oscillators, Side Channel Attack, Side-channel attacks, Switched-Capacitor Amplifier, Switches},
	pages = {770--773},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\23V9874N\\Kaushik and Hu - 2021 - Performance and Noise Trade-off for SC-based Power Side-Channel Attack Detection Circuits.pdf:application/pdf},
