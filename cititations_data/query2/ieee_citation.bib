	keywords = {countermeasure, Delays, Entropy, equiprobable quantization, Error correction, Error correction codes, Lehmer-Gray order encoding, loop PUF, Oscillators, Physical unclonable function, Reliability, side-channel analysis, two-metric helper data},
	pages = {5121--5134},
}

