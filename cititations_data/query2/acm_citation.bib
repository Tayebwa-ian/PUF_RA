editor = {Cristina Nita-Rotaru, Ashish Kundu, Attila A. Yavuz, Chung-Wei Lin, Tushin Mallick and Saleh Darzi},
title = {QRSEC '25: Proceedings of the 2025 1st Workshop on Quantum-Resistant Cryptography and Security},
year = {2025},
