@inproceedings{10.1145/3708036.3708094,
author = {Liu, Changxin and Zhu, Jiafeng and An, Zhenhuan and Kou, Yujiao and Li, Xiaomin and Li, Xiaohai and Chen, Chen and Ma, Jing and Xie, Pengshou},
title = {PWKTAP: A Lightweight Three-Factor Authentication Protocol for Smart Highways},
year = {2025},
isbn = {9798400709999},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3708036.3708094},
doi = {10.1145/3708036.3708094},
abstract = {To solve the challenge of the large number and types of IoT devices in smart highways, which makes it difficult to share authentication protocols, a three-factor authentication protocol (PWKTAP) based on PUF, wireless channel fingerprints, and keys is proposed. The PWKTAP employs the pseudo-identity of the device to protect the real identity information, and authenticates it using three factors, namely, the PUF response, the wireless channel fingerprints, and the keys, through a multi-information set of authentication values to verify the authenticity of the peer's identity and generate the session key. The security of the PWKTAP is analyzed using the Dolev-Yao attacker model and a non-formal analysis method. The results demonstrate that the proposed scheme can effectively resist the security threats posed by multiple attacks, while simultaneously enhancing the security of protocol authentication and reducing the computational overhead.},
booktitle = {Proceedings of the 2024 5th International Conference on Computer Science and Management Technology},
pages = {334–338},
numpages = {5},
keywords = {Internet of things, authentication, physically unclonable functions, sensor devices, smart highways},
location = {
},
series = {ICCSMT '24}
}

