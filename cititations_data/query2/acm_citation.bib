@inproceedings{10.1145/3672758.3672897,
author = {Li, Yichen and Zhao, Guolei},
title = {Anti-ROP Based on a Shadow Stack for Critical Embedded Systems},
year = {2024},
isbn = {9798400716942},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3672758.3672897},
doi = {10.1145/3672758.3672897},
abstract = {Due to the widespread integration of embedded devices in security-critical and safety-critical systems, an effective attack poses a significant threat to these vital systems. The compilation and execution characteristics inherent in embedded systems render them more susceptible to Return-Oriented Programming (ROP) attacks. However, the direct porting of various effective protection methods from Personal Computers (PCs) is hindered by disparities in both hardware and software configurations. Consequently, an anti-ROP method tailored for embedded devices utilizing a shadow stack is proposed. This method, efficiently implemented through binary instrumentation, operates independently of the source code in user-level software. Performance and space cost analysis demonstrates the applicability of this method to the majority of critical embedded systems.},
booktitle = {Proceedings of the 3rd International Conference on Computer, Artificial Intelligence and Control Engineering},
pages = {839–846},
numpages = {8},
location = {Xi' an, China},
series = {CAICE '24}
}

@inproceedings{10.1145/3789456.3796192,
author = {Ai, Xin and Li, Kun and Tu, Shanshan},
title = {A Quantum-Secure Authentication Protocol For UAV-GS Communications},
year = {2026},
isbn = {9798400722738},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789456.3796192},
doi = {10.1145/3789456.3796192},
abstract = {With the widespread deployment of unmanned aerial vehicles (UAVs) in both military and civilian domains, the demand for secure and encrypted communications in UAV networks integrated with ground stations has become increasingly prominent. Authentication and key agreement protocols are widely regarded as essential technical mechanisms for ensuring the security of data transmission in wireless communication environments. However, the rapid advancement of quantum computing technologies poses potential security threats to conventional protocols based on elliptic curve cryptography. To address these challenges, this paper proposes a quantum-secure authentication and key agreement protocol tailored for UAV–ground station communication scenarios. By incorporating Crystal-Kyber, the proposed protocol ensures quantum resistance while striving to minimize system computational overhead. The results of the informal security analysis indicate that the proposed protocol can effectively withstand a variety of known attacks. In addition, comprehensive comparative evaluations with existing related protocols demonstrate that, while maintaining low computational overhead, the proposed scheme exhibits stronger robustness in terms of security and functional properties.},
booktitle = {Proceedings of the 2025 15th International Conference on Communication and Network Security},
pages = {100–104},
numpages = {5},
keywords = {unmanned aerial vehicles, Authentication, Crystal-Kyber},
location = {
},
series = {ICCNS '25}
}

@inproceedings{10.1145/3549206.3549235,
author = {Paul, Anu and N., Mohankumar and M., Nirmala Devi},
title = {Obviating Multiple Attacks with Enhanced Logic Locking},
year = {2022},
isbn = {9781450396752},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3549206.3549235},
doi = {10.1145/3549206.3549235},
abstract = {With advancements in technology, attackers try to develop new threat models utilizing the loopholes in the security design techniques. Logical locking protects the design by the use of additional key inputs that makes the IC functional on the application of the correct key combination. SFLL is a popular logic locking method which is resilient to attacks like SAT attacks and brute force attacks. Introducing encrypt FF in sequential circuits make them resistant to logic cone based attacks and key sensitization attacks. In this paper a new technique which uses the underlying principles of encrypt FF as well as SFLL is proposed. The design is aimed at obtaining high output corruption which is verified by using Hamming distance and Jaccard similarity. Experimental results on ISCAS’89 benchmark circuits show that the improvement in security comes at the expense of design overheads.},
booktitle = {Proceedings of the 2022 Fourteenth International Conference on Contemporary Computing},
pages = {162–167},
numpages = {6},
keywords = {logic obfuscation, logic locking, hardware security, design for security, attacks},
location = {Noida, India},
series = {IC3-2022}
}

@inproceedings{10.1145/3321454.3321466,
author = {Hur, Ara and Kim, Jooeun and Ryu, Yeonseung},
title = {Hiding Vulnerabilities of Internet of Things Software Using Anti-Tamper Technique},
year = {2019},
isbn = {9781450366335},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3321454.3321466},
doi = {10.1145/3321454.3321466},
abstract = {With the advancement of Field Programmable Gate Array (FPGA) technology, the Internet of Things (IoT) devices are cheaply equipped with FPGA. In this work, we study a FPGA-based hiding technique of security vulnerabilities which are inevitably residing in the IoT software. When software engineers develop software code and perform static security testing, they could find vulnerabilities which cannot be removed from source code. For example, an IoT device needs to have hard-coded password in the source code in order to communicate with server. The proposed method isolates the parts of the source code that contain the security vulnerability, and then converts them to bitstream of specific FPGA circuit. It is difficult for attackers to find vulnerabilities that are implemented as a hardware circuit such as FPGA.},
booktitle = {Proceedings of the 2019 4th International Conference on Intelligent Information Technology},
pages = {46–50},
numpages = {5},
keywords = {Vulnerability, Software Testing, Internet of Things, FPGA, Anti-tamper},
location = {Da, Nang, Viet Nam},
series = {ICIIT '19}
}

