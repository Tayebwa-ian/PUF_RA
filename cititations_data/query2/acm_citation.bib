@inproceedings{10.1145/871506.871567,
author = {Weber, Werner},
title = {Ambient intelligence: industrial research on a visionary concept},
year = {2003},
isbn = {158113682X},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/871506.871567},
doi = {10.1145/871506.871567},
abstract = {In this presentation applications are discussed that describe achievements along the road towards 'Ambient Intelligence'. Appliances and devices disappear into the environment of the individual; instead services come into focus. Key to this development are systems solutions that lead to a significant improvement of the human-machine interface. Along this line, we present important technologies and key system components. They range from technologies for packaging and gathering of ambient energy, to system demonstrators such as low-cost electronic systems, ubiquitous sensor networks and electronics in smart textiles. The prime importance of the supply with electric power and of low-power consumption especially in the peripheral devices are emphasized.},
booktitle = {Proceedings of the 2003 International Symposium on Low Power Electronics and Design},
pages = {247–251},
numpages = {5},
keywords = {RF-ID tags, ambient intelligence, distributed networks, sensor networks, smart textiles, ubiquitous computing, wearable electronics},
