@inproceedings{10.1145/1403375.1403603,
author = {Mitra, Subhasish},
title = {Globally optimized robust systems to overcome scaled CMOS reliability challenges},
year = {2008},
isbn = {9783981080131},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/1403375.1403603},
doi = {10.1145/1403375.1403603},
abstract = {Future system design methodologies must accept the fact that the underlying hardware will be imperfect, and enable design of robust systems that are resilient to hardware imperfections. Three techniques that can enable a sea change in robust system design are: 1. Built-In Soft Error Resilience (BISER), 2. Circuit Failure Prediction, and 3. Concurrent Autonomous self-test using Stored Patterns (CASP). Global optimization across multiple abstraction layers is essential for cost-effective robust system design using these techniques.},
booktitle = {Proceedings of the Conference on Design, Automation and Test in Europe},
pages = {941–946},
numpages = {6},
location = {Munich, Germany},
