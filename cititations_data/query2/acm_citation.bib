@inproceedings{2492708.2492959,
author = {Guo, Xu and Srivastav, Meeta and Huang, Sinan and Ganta, Dinesh and Henry, Michael B. and Nazhandali, Leyla and Schaumont, Patrick},
title = {ASIC implementations of five SHA-3 finalists},
year = {2012},
